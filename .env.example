# =============================================================================
# WSSU Bridge Recruitment - Environment Variables
# =============================================================================
# Copy this file, rename the copy to ".env", and fill in your real values.
# NEVER commit your .env file to GitHub - it contains your password.
# =============================================================================

# SendGrid API key used for all outgoing emails
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Verified sender email configured in SendGrid
EMAIL_FROM=no-reply@yourdomain.com
